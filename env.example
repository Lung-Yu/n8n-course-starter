# TSMC n8n 課程環境變數
# 複製這個檔案為 .env，填入你的設定

# ============================
# 學員識別（老師課前分配）
# ============================
# 每位學員的 n8n port（第一位用 5678，第二位用 5679，以此類推）
N8N_PORT=5678

# ============================
# n8n 登入帳密
# ============================
N8N_USER=admin
N8N_PASSWORD=tsmc2026

# ============================
# Gemini API Key（Day 2 使用）
# ============================
# 取得方式：https://aistudio.google.com/api-keys
# 課堂也會提供共用 Key，填入課程共用 Key 即可
GEMINI_API_KEY=your_gemini_api_key_here

# ============================
# Jira Cloud（Day 1 Lab A 使用）
# ============================
# 你的 Atlassian domain（例如：mycompany.atlassian.net）
JIRA_DOMAIN=your-domain.atlassian.net

# 你的 Atlassian Email
JIRA_EMAIL=your@email.com

# Jira API Token（從 https://id.atlassian.com/manage-profile/security/api-tokens 取得）
JIRA_API_TOKEN=your_jira_api_token_here

# Jira Project Key（你的 demo project，例如 ITDEMO）
JIRA_PROJECT_KEY=ITDEMO
